{
  "name": "lac-securitytest",
  "version": "1.0.0",
  "description": "Security testing framework for Los Angeles Crimes 1.9.6 - Vulnerability research & patch validation",
  "type": "module",
  "main": "dist/agent/index.js",
  "bin": {
    "lac-cli": "./dist/cli/lac-cli.js"
  },
  "scripts": {
    "build:agent": "esbuild agent/index.ts --bundle --outfile=dist/agent/index.js --platform=node --format=cjs --target=node18 --external:frida --external:frida-il2cpp-bridge",
    "build:cli": "esbuild cli/lac-cli.ts --bundle --outfile=dist/cli/lac-cli.js --platform=node --format=cjs --target=node18",
    "build": "npm run build:agent && npm run build:cli",
    "dev:agent": "esbuild agent/index.ts --bundle --outfile=dist/agent/index.js --platform=node --format=cjs --target=node18 --external:frida --external:frida-il2cpp-bridge --sourcemap --watch",
    "dev:cli": "esbuild cli/lac-cli.ts --bundle --outfile=dist/cli/lac-cli.js --platform=node --format=cjs --target=node18 --sourcemap --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "setup": "bash scripts/setup-device.sh",
    "inject": "bash scripts/inject.sh"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "frida-compile": "^16.0.0"
  },
  "optionalDependencies": {
    "frida": "^16.0.0",
    "frida-il2cpp-bridge": "^0.13.0"
  },
  "keywords": ["security", "il2cpp", "frida", "unity", "mod-menu", "vulnerability-testing"],
  "author": "LAC Security Research",
  "license": "MIT"
}
