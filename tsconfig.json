{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@agent/*": ["agent/*"],
      "@cli/*": ["cli/*"],
      "@data/*": ["data/*"],
      "@utils/*": ["agent/utils/*"]
    },
    "types": ["node"]
  },
  "include": ["agent/**/*.ts", "cli/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
